{
  "name": "voxxy-presents-client",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "precheck": "npm run typecheck && npm run lint",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "seed:dev": "tsx scripts/seed-dev-data.ts",
    "sync:staging": "tsx scripts/sync-staging-data.ts",
    "clear:venues": "tsx scripts/clear-venue-database.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "setup": "./scripts/setup-environment.sh",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "build:staging": "NODE_ENV=staging VITE_ENVIRONMENT=staging npm run build",
    "build:production": "NODE_ENV=production VITE_ENVIRONMENT=production npm run build",
    "build:sandbox": "NODE_ENV=development VITE_ENVIRONMENT=sandbox npm run build",
    "mock-email-server": "node scripts/mock-email-server.mjs",
    "security-check": "node scripts/check-security.js",
    "cleanup-data": "tsx scripts/cleanup-firebase-data.ts",
    "seed-data": "tsx scripts/seed-test-data.ts",
    "refresh-env": "tsx scripts/refresh-environment.ts",
    "pre-deploy": "tsx scripts/pre-deployment-tests.ts",
    "deployment-ready": "tsx scripts/deployment-readiness.ts",
    "health-check": "echo 'Health check available in browser: window.__voxxy_health_check()'",
    "validate-env": "tsx scripts/validate-environment.ts"
  },
