{
  "name": "voxxy-presents-client",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "precheck": "npm run typecheck && npm run lint",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "seed:dev": "tsx scripts/seed-dev-data.ts",
    "sync:staging": "tsx scripts/sync-staging-data.ts",
    "clear:venues": "tsx scripts/clear-venue-database.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "setup": "./scripts/setup-environment.sh",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "build:staging": "NODE_ENV=staging VITE_ENVIRONMENT=staging npm run build",
    "build:production": "NODE_ENV=production VITE_ENVIRONMENT=production npm run build",
    "build:sandbox": "NODE_ENV=development VITE_ENVIRONMENT=sandbox npm run build",
    "mock-email-server": "node scripts/mock-email-server.mjs",
    "security-check": "node scripts/check-security.js",
    "cleanup-data": "tsx scripts/cleanup-firebase-data.ts",
    "seed-data": "tsx scripts/seed-test-data.ts",
    "refresh-env": "tsx scripts/refresh-environment.ts",
    "pre-deploy": "tsx scripts/pre-deployment-tests.ts",
    "deployment-ready": "tsx scripts/deployment-readiness.ts",
    "health-check": "echo 'Health check available in browser: window.__voxxy_health_check()'",
    "validate-env": "tsx scripts/validate-environment.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-aspect-ratio": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-collapsible": "latest",
    "@radix-ui/react-context-menu": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-hover-card": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-menubar": "latest",
    "@radix-ui/react-navigation-menu": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slider": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-toggle": "latest",
    "@radix-ui/react-toggle-group": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "latest",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "latest",
    "esbuild": "^0.25.10",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.5.0",
    "geist": "latest",
    "input-otp": "latest",
    "lucide-react": "^0.454.0",
    "mixpanel-browser": "^2.70.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "latest",
    "react-dom": "^18.3.1",
    "react-hook-form": "latest",
    "react-resizable-panels": "latest",
    "react-router-dom": "^7.7.1",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "latest",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
