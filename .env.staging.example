# Staging Environment
# Copy to .env.staging for staging deployment

# Environment identifier
VITE_ENVIRONMENT=staging

# API Configuration (Staging API)
VITE_API_BASE_URL=https://www.voxxyai.com/api

# Analytics Configuration
VITE_MIXPANEL_TOKEN=your-mixpanel-staging-token-here

# Feature Flags
VITE_DEBUG_MODE=true
VITE_EXPERIMENTAL_FEATURES=false
