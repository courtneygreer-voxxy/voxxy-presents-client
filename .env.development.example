# Development Environment
# Copy to .env.development for local development

# Environment identifier
VITE_ENVIRONMENT=development

# API Configuration (Local Rails Backend - RECOMMENDED for development)
# Use http://localhost:3001/api for local Rails server
# Use https://www.voxxyai.com/api if testing against staging
VITE_API_BASE_URL=http://localhost:3001/api

# Analytics Configuration
VITE_MIXPANEL_TOKEN=your-mixpanel-token-here

# Feature Flags
VITE_DEBUG_MODE=true
VITE_EXPERIMENTAL_FEATURES=true
