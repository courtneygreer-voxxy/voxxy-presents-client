# Development Environment
# Copy to .env.development for local development

# Environment identifier
VITE_ENVIRONMENT=development

# API Configuration (Development API)
VITE_API_BASE_URL=https://www.voxxyai.com/api

# Analytics Configuration
VITE_MIXPANEL_TOKEN=your-mixpanel-token-here

# Feature Flags
VITE_DEBUG_MODE=true
VITE_EXPERIMENTAL_FEATURES=true
